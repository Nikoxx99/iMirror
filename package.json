{
  "name": "imirror",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Turn an iPhone or Android phone into a private Windows 11 webcam over local Wi-Fi.",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "benchmark:frame-pump": "node --experimental-strip-types scripts/benchmark-frame-pump.ts",
    "clean": "turbo clean",
    "dev:phone": "pnpm --filter @imirror/phone dev",
    "dev:desktop": "pnpm --filter @imirror/desktop tauri dev",
    "build:phone": "pnpm --filter @imirror/phone build",
    "build:desktop": "pnpm --filter @imirror/desktop build",
    "package:windows": "pnpm --filter @imirror/desktop tauri build --bundles nsis",
    "check:rust": "cd apps/desktop/src-tauri && cargo check",
    "test:rust": "cd apps/desktop/src-tauri && cargo test",
    "install:windows-camera": "powershell -ExecutionPolicy Bypass -File drivers/windows/Install-iMirrorCamera.ps1",
    "uninstall:windows-camera": "powershell -ExecutionPolicy Bypass -File drivers/windows/Uninstall-iMirrorCamera.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
