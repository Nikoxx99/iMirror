{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iMirror",
  "version": "0.1.0",
  "identifier": "io.github.nikoxx99.imirror",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "corepack pnpm@11.3.0 --filter @imirror/phone build && corepack pnpm@11.3.0 build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "iMirror",
        "create": false,
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": true,
        "skipTaskbar": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:* ws://127.0.0.1:* ws://[::1]:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Use your phone as a private wireless webcam on Windows 11.",
    "longDescription": "iMirror turns an iPhone or Android camera into a low-latency Windows webcam over your local Wi-Fi network.",
    "publisher": "Nikoxx99",
    "copyright": "Copyright © 2026 Nikoxx99 and iMirror contributors",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../../drivers/windows/UnityCaptureFilter64.dll": "drivers/UnityCaptureFilter64.dll",
      "../../../drivers/windows/Install-iMirrorCamera.ps1": "drivers/Install-iMirrorCamera.ps1",
      "../../../drivers/windows/Uninstall-iMirrorCamera.ps1": "drivers/Uninstall-iMirrorCamera.ps1",
      "../../../drivers/windows/THIRD_PARTY_NOTICES.md": "drivers/THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
